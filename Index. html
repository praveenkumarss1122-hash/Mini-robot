<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mini Robot</title><style>body{background:#000;color:#fff;text-align:center;font-family:sans-serif;padding:15px}#r{font-size:80px;animation:p 2s infinite}@keyframes p{50%{transform:scale(1.1)}}button{padding:12px 22px;margin:6px;border-radius:25px;border:0;background:#FF0066;color:#fff;font-size:16px}#off{display:none;position:fixed;inset:0;background:#000;z-index:99;padding-top:45vh;font-size:26px}</style></head><body>
<div id="off" onclick="this.style.display='none'">Tap to Wake Up</div>
<div id="r">🤖</div><h3>Mini Robot</h3><p id="s">Hi Parveen! Ready</p><p id="h" style="color:#FF99CC"></p>
<button onclick="listen()">🎤 Matladu</button>
<button onclick="photo()">📸 Photo</button>
<button onclick="off.style.display='block'">🌙 Screen Off</button><br>
<video id="v" autoplay playsinline style="width:90%;border-radius:12px;margin-top:10px"></video><canvas id="c" style="display:none"></canvas>
<script>
let v=document.getElementById('v'),s=document.getElementById('s'),h=document.getElementById('h'),off=document.getElementById('off');
function sp(t){let u=new SpeechSynthesisUtterance(t);u.pitch=1.35;u.rate=0.9;speechSynthesis.speak(u);s.innerText=t}
function listen(){let R=window.SpeechRecognition||window.webkitSpeechRecognition;if(!R){alert("Chrome lo open chey");return}let r=new R();r.lang='te-IN';r.start();s.innerText="Vintunna...";r.onresult=e=>{let c=e.results[0][0].transcript.toLowerCase();h.innerText="Nuvvu: "+c;
if(c.includes('screen off')||c.includes('nidra')){off.style.display='block';sp('Good night, screen off chestunna')}
else if(c.includes('on chey')||c.includes('wake')){off.style.display='none';sp('Welcome back boss')}
else if(c.includes('photo')||c.includes('camera'))photo();
else if(c.includes('youtube')){let q=c.replace('youtube','');sp(q+' YouTube lo');open('https://www.youtube.com/results?search_query='+q)}
else if(c.includes('search')||c.includes('google')){let q=c.replace('search','').replace('google','');open('https://www.google.com/search?q='+q);sp(q+' search')}
else if(c.includes('call')){let n=c.replace(/\D/g,'');if(n.length>=10)location.href='tel:'+n}
else sp('Ok Parveen, '+c)
}}
async function photo(){let st=await navigator.mediaDevices.getUserMedia({video:true});v.srcObject=st;setTimeout(()=>{c.width=640;c.height=480;c.getContext('2d').drawImage(v,0,0);let a=document.createElement('a');a.download='photo.png';a.href=c.toDataURL();a.click();sp('Photo teesa')},1500)}
window.onload=()=>sp('Hi Parveen, nenu ready!')
</script></body></html>
